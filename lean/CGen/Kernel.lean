/-
The C code generator — elementwise operator kernels.

An operator is an `Elementwise` description: its name and its element
operation.  `operatorsFile` turns a list of those descriptions into a C
translation unit holding, for every operator and every element type, a kernel

    void sonnx_<op>_<type>(const sonnx_tensor *a, const sonnx_tensor *b,
                           sonnx_tensor *c)

that writes the elementwise results into `c`.  A tensor is the generated
`sonnx_tensor` struct: a `void *data` array, the rank `ndim` and a pointer to
the `ndim` dimensions.

The contract, which the banner of the generated file states, is deliberately
narrow:

* the data arrays are contiguous row-major arrays and `a`, `b` and `c`
  describe the same, already broadcast, shape;
* broadcasting is the caller's responsibility;
* the kernel computes the element count from `c->ndim` and `c->shape`, so a
  rank-0 tensor has one element and a zero-sized dimension has none;
* the integer kernels wrap modulo `2 ^ bits` (`Sonnx.uintWrap`,
  `Sonnx.sintWrap`): a signed result is computed in the unsigned type of the
  same width and converted back, so the arithmetic itself is well defined;
* `float16` is not generated: Lean's model has it, C has no standard type
  for it.  `float32` and `float64` are.

`rhsFor` is the only element-type-dependent part; the function shape is
shared, so the prototype and the definition are rendered from the same `Fun`
and cannot drift apart.
-/

import CGen.Ast

namespace CGen

/-- An elementwise operator: a name and the element operation. -/
structure Elementwise where
  name : String
  op : BinOp
  deriving Repr, Inhabited

/-- The operators generated by `operatorsFile`.  Adding an operator means
adding a row here, provided its element step is a single binary operation. -/
def operators : List Elementwise :=
  [⟨"add", .add⟩, ⟨"sub", .sub⟩, ⟨"mul", .mul⟩]

/-- The element types, in the order the functions are emitted. -/
def dtypes : List CType :=
  [.float 32, .float 64,
   .int 8 true, .int 16 true, .int 32 true, .int 64 true,
   .int 8 false, .int 16 false, .int 32 false, .int 64 false]

/-- The type family a derivation comes from.  The real family has no C type. -/
inductive Family where
  | real | float | int | uint
  deriving Repr, DecidableEq, Inhabited

/-- The family's name in the manifest and the C comments. -/
def familyName : Family → String
  | .real => "real"
  | .float => "float"
  | .int => "int"
  | .uint => "uint"

/-- One derivation: the formal declaration a kernel is derived from, the path
the frontier search followed to the element step, the trace key and informal
span, and the arithmetic operations that path exposed. -/
structure Derivation where
  family : Family
  declaration : String
  witness : String
  requirement : String
  source : String
  ops : List String
  deriving Repr, Inhabited

/-- An elementwise operator together with the derivations of its kernels. -/
structure Derived where
  op : Elementwise
  derivations : List Derivation
  deriving Repr, Inhabited

/-- The family a C element type belongs to.  The real family has no C type. -/
def dtypeFamily : CType → Option Family
  | .float _ => some .float
  | .int _ true => some .int
  | .int _ false => some .uint
  | _ => none

/-- The element types for which a derivation exists. -/
def dtypesFor (derivations : List Derivation) : List CType :=
  dtypes.filter (fun t =>
    match dtypeFamily t with
    | some family => derivations.any (fun d => d.family == family)
    | none => false)

/-- The suffix used in a kernel's name for an element type. -/
def dtypeSuffix : CType → String
  | .float 32 => "f32"
  | .float 64 => "f64"
  | .int bits true => "i" ++ toString bits
  | .int bits false => "u" ++ toString bits
  | _ => "unknown"

/-- The name of the kernel for an operator and an element type:
`sonnx_sub_i8`, say. -/
def funName (e : Elementwise) (t : CType) : String :=
  s!"sonnx_{e.name}_{dtypeSuffix t}"

/-- The written name of a binary operator.  The pipeline's driver prints it
next to the operator's name, so that the C stage can check the descriptor the
formal specification declares before it renders anything. -/
def binOpName : BinOp → String
  | .add => "add" | .sub => "sub" | .mul => "mul" | .div => "div"
  | .mod => "mod" | .shl => "shl" | .shr => "shr"
  | .bitAnd => "bitAnd" | .bitOr => "bitOr" | .bitXor => "bitXor"
  | .lt => "lt" | .le => "le" | .gt => "gt" | .ge => "ge"
  | .eq => "eq" | .ne => "ne" | .logAnd => "logAnd" | .logOr => "logOr"
  | .assign => "assign" | .comma => "comma"

/-- The tensor type the kernels take.  It is a `named` C type: the struct
itself is `tensorStruct`. -/
def tensor : CType := .named "sonnx_tensor"

/-- The `sonnx_tensor` definition the generated header carries: the data
array, the rank and a pointer to the dimensions.  The data pointer is
untyped; the kernel name selects the element type. -/
def tensorStruct : Decl :=
  .structDef "sonnx_tensor"
    [⟨.ptr .void, "data"⟩, ⟨.size, "ndim"⟩, ⟨.ptr (.const .size), "shape"⟩]

/-- The value written into `c[i]`: `<a>[i] <op> <b>[i]` for floating point,
computed in the unsigned type of the same width and converted back for signed
integers, and computed then converted modulo `2 ^ bits` for unsigned integers.
The element type is also the type of `c[i]`, so the assignment converts
exactly once.  The operands are expressions so that the kernel can index its
typed local pointers, while `rhs` keeps the `a[i]`/`b[i]` spelling the printer
probes use. -/
def rhsFor (op : BinOp) (t : CType) (a b : Expr) : Expr :=
  match t with
  | .float _ => .binary op a b
  | .int bits true =>
      let unsigned : CType := .int bits false
      .cast t (.binary op (.cast unsigned a) (.cast unsigned b))
  | _ => .cast t (.binary op a b)

/-- The `a[i] <op> b[i]` element expression. -/
def rhs (op : BinOp) (t : CType) : Expr :=
  rhsFor op t (.index (.var "a") (.var "i")) (.index (.var "b") (.var "i"))

/-- The kernel for an operator and an element type:

    void sonnx_<op>_<type>(const sonnx_tensor *a, const sonnx_tensor *b,
                           sonnx_tensor *c) {
      const T *A = (const T *)a->data;
      const T *B = (const T *)b->data;
      T *C = (T *)c->data;
      size_t n = 1;
      for (size_t d = 0; d < c->ndim; d++) {
        n = n * c->shape[d];
      }
      for (size_t i = 0; i < n; i++) {
        C[i] = <element expression>;
      }
    }

The rank-0 tensor has one element (the product of no dimensions is 1); a
zero-sized dimension makes `n` zero and writes nothing.  The index is
`size_t`, which also keeps the comparison free of sign-conversion warnings. -/
def kernel (e : Elementwise) (t : CType) : Fun :=
  { name := funName e t
    retType := .void
    params :=
      [⟨.ptr (.const tensor), "a"⟩, ⟨.ptr (.const tensor), "b"⟩, ⟨.ptr tensor, "c"⟩]
    body :=
      [.decl (.ptr (.const t)) "A"
         (some (.cast (.ptr (.const t)) (.field (.var "a") "data" true))),
       .decl (.ptr (.const t)) "B"
         (some (.cast (.ptr (.const t)) (.field (.var "b") "data" true))),
       .decl (.ptr t) "C"
         (some (.cast (.ptr t) (.field (.var "c") "data" true))),
       .decl .size "n" (some (.intLit 1)),
       .forLoop
         (some (.decl .size "d" (some (.intLit 0))))
         (some (.binary .lt (.var "d") (.field (.var "c") "ndim" true)))
         (some (.unary .postInc (.var "d")))
         (.block [.expr (.binary .assign (.var "n")
           (.binary .mul (.var "n")
             (.index (.field (.var "c") "shape" true) (.var "d"))))]),
       .forLoop
         (some (.decl .size "i" (some (.intLit 0))))
         (some (.binary .lt (.var "i") (.var "n")))
         (some (.unary .postInc (.var "i")))
         (.block [.expr (.binary .assign (.index (.var "C") (.var "i"))
           (rhsFor e.op t (.index (.var "A") (.var "i"))
                           (.index (.var "B") (.var "i"))))])] }

/-- Every kernel of every operator in `ops`, for every element type. -/
def funsFor (ops : List Elementwise) (types : List CType) : List Fun :=
  ops.flatMap (fun e => types.map (kernel e))

/-- Every kernel: every operator of the library's table for every element
type. -/
def funs : List Fun := funsFor operators dtypes

/-- The derivation comment above a kernel: the Lean declaration, the witness
path, the trace key and informal span, and the derived operation. -/
def derivationComment (e : Elementwise) (t : CType) (s : Derivation) : List String :=
  [s!"{funName e t}: derived from {s.declaration} ({s.witness}); "
    ++ s!"{s.requirement}; {s.source}; operation {binOpName e.op}"]

/-- The kernel of a derived operator and an element type, with the comment
that names its derivation.  An element type whose family has no derivation is
not rendered by `funsForDerived`; here it simply has no comment. -/
def kernelFor (d : Derived) (t : CType) : Fun :=
  let fn := kernel d.op t
  match dtypeFamily t with
  | some family =>
      match d.derivations.find? (fun s => s.family == family) with
      | some s => { fn with comment := derivationComment d.op t s }
      | none => fn
  | none => fn

/-- Every kernel of every derived operator, for the element types whose family
has a derivation. -/
def funsForDerived (ds : List Derived) : List Fun :=
  ds.flatMap (fun d => (dtypesFor d.derivations).map (kernelFor d))

/-- The comment block at the top of the generated file.  It states the
contract the kernels assume. -/
def banner : List String :=
  ["Generated by the SONNX CGen library. Do not edit.",
   "",
   "Elementwise kernels over sonnx_tensor values: a contiguous row-major",
   "data array, its rank and a pointer to its dimensions.  The kernel name",
   "selects the element type; data is void * and is cast to it.",
   "Broadcasting is the caller's responsibility: a, b and c must describe",
   "the same (already broadcast) shape.  The kernel computes the element",
   "count from c->ndim and c->shape, so a rank-0 tensor has one element",
   "and a zero-sized dimension has none.",
   "",
   "Signed integer kernels wrap modulo 2^bits (Sonnx.sintWrap); unsigned",
   "kernels wrap modulo 2^bits (Sonnx.uintWrap). float16 is not generated."]

/-- The generated translation unit: banner, includes, then a prototype and a
definition of every kernel. -/
def operatorsFileFor (ops : List Elementwise) (types : List CType) : CFile :=
  let funs := funsFor ops types
  { banner := banner
    includes := ["stddef.h", "stdint.h"]
    decls := tensorStruct :: ((funs.map (fun f => .funDecl f)) ++
                              (funs.map (fun f => .funDef f))) }

/-- The library's own translation unit. -/
def operatorsFile : CFile := operatorsFileFor operators dtypes

/-- The name of the header the split source includes.  The C stage writes the
header and the source next to each other, and the test program includes the
header. -/
def headerName : String := "sonnx_kernels.h"

/-- The prototypes of the kernels of `ops`, as a header. -/
def headerFileFor (ops : List Elementwise) (types : List CType) : CFile :=
  { banner := banner
    includes := ["stddef.h", "stdint.h"]
    decls := tensorStruct :: (funsFor ops types).map (fun f => .funDecl f) }

/-- The definitions of the kernels of `ops`, as a source file that includes the
header: the header supplies the prototypes and the standard includes. -/
def sourceFileFor (ops : List Elementwise) (types : List CType) : CFile :=
  { banner := banner
    includes := ["\"" ++ headerName ++ "\""]
    decls := (funsFor ops types).map (fun f => .funDef f) }

/-- The banner of a file whose kernels are derived from a formal
specification. -/
def derivedBanner : List String :=
  banner ++
    ["",
     "Derived from the Lean formal specification; each kernel's comment names",
     "its Lean declaration, the frontier path, the @trace key and the informal",
     "source span it comes from."]

/-- The prototypes of the derived operators, as a header. -/
def headerFileForDerived (ds : List Derived) : CFile :=
  { banner := derivedBanner
    includes := ["stddef.h", "stdint.h"]
    decls := tensorStruct :: (funsForDerived ds).map (fun f => .funDecl f) }

/-- The definitions of the derived operators, as a source file. -/
def sourceFileForDerived (ds : List Derived) : CFile :=
  { banner := derivedBanner
    includes := ["\"" ++ headerName ++ "\""]
    decls := (funsForDerived ds).map (fun f => .funDef f) }

/-- The all-in-one translation unit of the derived operators. -/
def operatorsFileForDerived (ds : List Derived) : CFile :=
  let funs := funsForDerived ds
  { banner := derivedBanner
    includes := ["stddef.h", "stdint.h"]
    decls := tensorStruct :: ((funs.map (fun f => .funDecl f)) ++
                              (funs.map (fun f => .funDef f))) }

end CGen
